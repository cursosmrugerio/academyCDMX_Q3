# Eclipse workspace metadata (incluye sus locks y logs)
# Los .project, .classpath y .settings SI se versionan: son portables y
# permiten importar cada proyecto en Eclipse recien clonado el repo.
.metadata/

# Otros IDEs (el proyecto se versiona en formato Eclipse)
.idea/
*.iml
.vscode/

# Claude Code: ajustes locales de cada maquina.
# .claude/settings.json (el compartido) SI se versiona.
.claude/settings.local.json

# Compiled output
bin/
build/
out/
target/
*.class

# macOS
.DS_Store

# Java
*.jar
# Excepcion: las librerias que un proyecto necesita para compilar SI se versionan,
# porque .classpath las referencia y sin ellas el proyecto no compila al clonar.
!**/lib/*.jar
*.war
*.ear
hs_err_pid*

# Secretos de ejecucion. taskflow-api/.env lo lee docker compose y lleva la
# contrasena de Postgres y el JWT_SECRET reales. Lo que SI se versiona es
# .env.example, que documenta QUE variables existen sin sus valores.
.env

# Base de datos H2 en ARCHIVO que taskflow-api crea al arrancar en local
# (jdbc:h2:file:./data/taskflow). Es estado de ejecucion de cada maquina, no fuente.
**/data/*.mv.db
**/data/*.trace.db

# Llaves privadas de SSH. Van siempre FUERA del repo, pero basta con que alguien
# deje una aqui una vez para que quien clone se lleve una credencial ajena: sin
# esta regla, un `git add .` la publicaria.
*.pem
*.ppk
*.key
# Excepcion: las llaves del ejercicio de JWT SI se versionan. Son material
# didactico generado para la practica (no protegen nada real) y sin ellas
# el proyecto que las usa no arranca al clonar.
!**/src/main/resources/certs/*.pem
